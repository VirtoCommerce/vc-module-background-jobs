<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>

    <!-- This project produces a forwarding-only VirtoCommerce.Platform.Hangfire.dll. The Hangfire engine was
         moved into VirtoCommerce.BackgroundJobs.Hangfire.dll; this assembly keeps the original assembly name and
         namespaces so existing modules that reference VirtoCommerce.Platform.Hangfire keep binding (type-forwarding). -->
    <AssemblyName>VirtoCommerce.Platform.Hangfire</AssemblyName>
    <RootNamespace>VirtoCommerce.Platform.Hangfire</RootNamespace>
    <PackageId>VirtoCommerce.Platform.Hangfire</PackageId>

    <!-- Match the platform's version scheme so existing references bind (assemblies are not strong-named, so
         binding is by simple name; the explicit version also helps the module loader's highest-version-wins copy policy). -->
    <Version>3.1042.0</Version>
    <AssemblyVersion>3.1042.0.0</AssemblyVersion>
    <FileVersion>3.1042.0.0</FileVersion>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>1591;NU5048;NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.BackgroundJobs.Hangfire\VirtoCommerce.BackgroundJobs.Hangfire.csproj" />
  </ItemGroup>

</Project>
