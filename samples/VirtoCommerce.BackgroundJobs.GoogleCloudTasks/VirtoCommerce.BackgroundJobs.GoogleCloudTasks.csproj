<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>

  <!--
    A worked-example CUSTOM ENGINE module: a push-based background-job engine backed by Google Cloud Tasks.
    It self-activates when VirtoCommerce:BackgroundJobs:Provider == "GoogleCloudTasks" and registers an IJobEngine,
    proving the engine extension points without modifying the host module.

    It references VirtoCommerce.BackgroundJobs.Core (the engine port + agnostic services) and .Data (the reusable
    in-process recurring scheduler). A real out-of-repo module would consume these as NuGet packages instead of the
    project references used here; the runtime dependency on the host module is declared in module.manifest.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Tasks.V2" Version="3.6.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtoCommerce.BackgroundJobs.Core\VirtoCommerce.BackgroundJobs.Core.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.BackgroundJobs.Data\VirtoCommerce.BackgroundJobs.Data.csproj" />
  </ItemGroup>

</Project>
