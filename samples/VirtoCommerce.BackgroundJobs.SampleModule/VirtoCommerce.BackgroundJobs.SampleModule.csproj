<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>

  <!--
    A sample CONSUMER module. Everything it uses — basic enqueue, recurring jobs, AND map/reduce — needs ONLY
    VirtoCommerce.Platform.Core: the job and map/reduce CONTRACTS (IBackgroundJob/IBackgroundJobHandler,
    IMapJobHandler/IReduceJobHandler/IMapReduceJob/MapResult/AddMapReduceJob) all live there. There is NO compile-time
    dependency on the engine module; the runtime dependency on the engine is declared in module.manifest.
  -->
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.Platform.Core" Version="3.1046.0-alpha.13366-vcst-5245" />
  </ItemGroup>

</Project>
