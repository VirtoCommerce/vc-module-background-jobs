<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>

  <!--
    A sample CONSUMER module. Basic enqueue + recurring jobs need ONLY VirtoCommerce.Platform.Core (no compile-time
    dependency on the engine) — the runtime dependency on the engine module is declared in module.manifest.

    The map/reduce demo additionally references VirtoCommerce.BackgroundJobs.Core, because the map/reduce contracts
    (IMapJobHandler/IReduceJobHandler/IMapReduceJob/AddMapReduceJob) live in that packable host package. A real
    out-of-repo module would reference it as a NuGet; here it is a project reference.
  -->
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.Platform.Core" Version="3.1039.0-alpha.13313-vcst-5245" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtoCommerce.BackgroundJobs.Core\VirtoCommerce.BackgroundJobs.Core.csproj" />
  </ItemGroup>

</Project>
