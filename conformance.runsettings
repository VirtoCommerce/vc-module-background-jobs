<?xml version="1.0" encoding="utf-8"?>
<!--
  Run settings for the background-job engine conformance suite.

  Set the connection string(s) for the engines you want to certify, then select this file in Visual Studio
  Test Explorer:  Test menu > Configure Run Settings > Select Solution Wide runsettings File > pick this file.
  (From the CLI, pass it with the dotnet test "settings" switch.)

  Engines whose connection variable is not set here are skipped automatically, so leaving a line out is fine.
  RabbitMQ uses an AMQP uri (port 5672), NOT the management UI (port 15672).
-->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <VC_CONFORMANCE_RABBITMQ>amqp://guest:guest@localhost:5672/</VC_CONFORMANCE_RABBITMQ>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
